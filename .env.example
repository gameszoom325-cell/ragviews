# OpenAI API key for RAGAS evaluation LLM backend
OPENAI_API_KEY=your_openai_api_key_here

# MCP RAG Server URL or stdio command
# Examples:
#   SSE endpoint:   MCP_SERVER_URL=http://localhost:8000/mcp
#   Stdio command:  MCP_SERVER_URL=python server.py
MCP_SERVER_URL=http://localhost:8000/mcp

# Optional: Preferred MCP retrieval tool name (auto-detected if omitted)
# MCP_TOOL_NAME=retrieve

# Optional: Query timeout in seconds (default is 30)
# MCP_TIMEOUT=30
